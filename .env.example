# Copy to .env.local for local development, or set these in your Vercel
# project settings. They are read only by the server functions in /api and
# are never sent to the browser.

# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Optional: raises Gravatar's rate limit. https://gravatar.com/developers
GRAVATAR_API_KEY=
